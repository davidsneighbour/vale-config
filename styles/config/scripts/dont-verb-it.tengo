text := import("text")
matches := []
contrasts := text.re_find("(?i)\\b(?:do\\s+not|don['\u2019]t)\\s+(?:(?:just|simply|merely)\\s+)?(\\w+)(?:\\s+(?:of|about|at|on|for|with|to))?\\s+it\\b[^.!?\\n]*?[.!?;,:\u2013\u2014]['\"\u201d\u2019]*\\s*(?:(?:just|simply|merely)\\s+)?(\\w+)(?:\\s+(?:of|about|at|on|for|with|to))?\\s+it\\b", scope, -1)
if !is_undefined(contrasts) {
    for contrast in contrasts {
        if text.to_lower(contrast[1].text) == text.to_lower(contrast[2].text) {
            matches = append(matches, {begin: contrast[0].begin, end: contrast[0].end})
        }
    }
}
